# Function to categorize correlation strength
def get_strength_band(r):
    abs_r = abs(r)
    if abs_r < 0.2:
        return "Negligible"
    elif abs_r < 0.4:
        return "Weak"
    elif abs_r < 0.7:
        return "Moderate"
    else:
        return "Strong"

