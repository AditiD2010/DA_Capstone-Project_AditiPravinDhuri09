a) Order totals - 
SELECT
    COUNT(*) AS total_orders,
    SUM(
        o.quantity * p.price *
        (1 - COALESCE(o.discount_pct, 0) / 100.0)
    ) AS total_revenue,
    AVG(
        o.quantity * p.price *
        (1 - COALESCE(o.discount_pct, 0) / 100.0)
    ) AS average_order_value
FROM orders o
JOIN products p
    ON o.product_id = p.product_id;
